{
  "manifest_version": 3,
  "name": "CipherNet",
  "version": "2.3.3",
  "description": "Decrypts CipherNet API request payloads.",
  "minimum_chrome_version": "88",
  "devtools_page": "devtools.html",
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
